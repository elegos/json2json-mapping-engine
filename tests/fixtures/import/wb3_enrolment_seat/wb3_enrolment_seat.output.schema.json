{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Seat API body (synthetic)",
  "oneOf": [
    {
      "title": "POST body",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "senderMsgId",
        "source",
        "sentAt",
        "student",
        "seatCount",
        "seats"
      ],
      "properties": {
        "senderMsgId": {
          "type": "string"
        },
        "source": {
          "type": "object",
          "required": [
            "name"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "const": "REG"
            }
          }
        },
        "sentAt": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "FULL",
            "PART"
          ]
        },
        "student": {
          "type": "object",
          "required": [
            "campusCode",
            "studentType",
            "studentNumber"
          ],
          "additionalProperties": false,
          "properties": {
            "campusCode": {
              "type": "string"
            },
            "studentType": {
              "type": "string"
            },
            "studentNumber": {
              "type": "string"
            }
          }
        },
        "primaryTag": {
          "type": "string"
        },
        "seatStatus": {
          "enum": [
            "CONFIRMED",
            "PENDING"
          ]
        },
        "seatCount": {
          "type": "integer",
          "minimum": 0
        },
        "seats": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "seq",
              "kind",
              "start",
              "end"
            ],
            "properties": {
              "seq": {
                "type": "integer"
              },
              "kind": {
                "enum": [
                  "LECTURE",
                  "LAB"
                ]
              },
              "roomId": {
                "type": "string"
              },
              "start": {
                "type": "string"
              },
              "end": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "title": "DELETE body",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seatRef",
        "reason"
      ],
      "properties": {
        "seatRef": {
          "type": "string"
        },
        "reason": {
          "const": "WITHDRAWN"
        },
        "effectiveDate": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    }
  ]
}
